# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/copy-maplibre.mjs
/public/maplibre/

# raw downloads: re-create with `npm run data`
/data/raw/*.geojson
/data/raw/docs/Basement_Backup_Handbook_2023.pdf

# internal research, strategy and pitch notes (kept local)
/docs/
